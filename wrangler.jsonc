{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-workspace",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "link-workspace-db",
      "database_id": "b3e697da-d8af-4076-b23d-9a805a8f8b66",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "preview_urls": false
}
