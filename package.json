{
  "name": "link-workspace-render",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "vite build",
    "start": "node src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --test scripts/share-url.test.mjs scripts/resource-page.test.mjs scripts/feature-boundaries.test.mjs scripts/traffic.test.mjs scripts/feishu-handoff.test.mjs scripts/workspace-refresh.test.mjs && node scripts/smoke-test.mjs && node scripts/features-smoke.mjs",
    "cf:dev": "wrangler dev --ip 127.0.0.1",
    "cf:build": "npm run build && wrangler deploy --dry-run",
    "cf:pages-build": "node scripts/build-pages.mjs",
    "test:features": "node scripts/features-smoke.mjs",
    "test:pages": "node scripts/smoke-test.mjs --pages && node scripts/features-smoke.mjs --pages"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "lucide-react": "1.31.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsqr": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  }
}
